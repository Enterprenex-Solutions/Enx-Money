// ZeroCarbonix EWMS — Prisma Relational Schema
// Fully normalized PostgreSQL architecture with multi-tenancy preparation (organizationId on all entities)

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Organization {
  id          String   @id @default(uuid())
  name        String
  slug        String   @unique
  domain      String?
  status      String   @default("ACTIVE") // ACTIVE, SUSPENDED
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  users        User[]
  roles        Role[]
  departments  Department[]
  teams        Team[]
  employees    Employee[]
  projects     Project[]
  tasks        Task[]
  attendance   Attendance[]
  workSessions WorkSession[]
  auditLogs    AuditLog[]

  @@map("organizations")
}

model User {
  id                 String    @id @default(uuid())
  organizationId     String    @map("organization_id")
  email              String    @unique
  passwordHash       String    @map("password_hash")
  isMfaEnabled       Boolean   @default(false) @map("is_mfa_enabled")
  mfaSecret          String?   @map("mfa_secret") // Encrypted TOTP secret
  status             String    @default("ACTIVE") // ACTIVE, LOCKED, DEACTIVATED
  failedLoginAttempts Int      @default(0) @map("failed_login_attempts")
  lockedUntil        DateTime? @map("locked_until")
  lastLoginAt        DateTime? @map("last_login_at")
  refreshTokenHash   String?   @map("refresh_token_hash")
  createdAt          DateTime  @default(now()) @map("created_at")
  updatedAt          DateTime  @updatedAt @map("updated_at")

  organization       Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  userRoles          UserRole[]
  employee           Employee?

  @@index([organizationId, email])
  @@map("users")
}

model Role {
  id             String   @id @default(uuid())
  organizationId String   @map("organization_id")
  code           String   // SUPER_ADMIN, COMPANY_ADMIN, HR_ADMIN, PROJECT_MANAGER, TEAM_LEAD, EMPLOYEE, INTERN, CLIENT
  name           String
  description    String?
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  organization   Organization     @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  userRoles      UserRole[]
  rolePermissions RolePermission[]

  @@unique([organizationId, code])
  @@map("roles")
}

model Permission {
  id          String   @id @default(uuid())
  code        String   @unique // e.g. task.create, employee.view, salary.view
  module      String   // tasks, employees, projects, etc.
  description String?
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  rolePermissions RolePermission[]

  @@map("permissions")
}

model RolePermission {
  id           String @id @default(uuid())
  roleId       String @map("role_id")
  permissionId String @map("permission_id")

  role         Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@unique([roleId, permissionId])
  @@map("role_permissions")
}

model UserRole {
  id        String   @id @default(uuid())
  userId    String   @map("user_id")
  roleId    String   @map("role_id")
  createdAt DateTime @default(now()) @map("created_at")

  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  role      Role     @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@unique([userId, roleId])
  @@map("user_roles")
}

model Department {
  id             String   @id @default(uuid())
  organizationId String   @map("organization_id")
  name           String
  code           String
  description    String?
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  teams          Team[]
  employees      Employee[]

  @@unique([organizationId, code])
  @@map("departments")
}

model Team {
  id             String   @id @default(uuid())
  organizationId String   @map("organization_id")
  departmentId   String   @map("department_id")
  name           String
  description    String?
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  department     Department   @relation(fields: [departmentId], references: [id], onDelete: Cascade)
  employees      Employee[]

  @@map("teams")
}

model Employee {
  id                  String   @id @default(uuid())
  organizationId      String   @map("organization_id")
  userId              String   @unique @map("user_id")
  employeeCode        String   @map("employee_code") // e.g. ZC-1001
  firstName           String   @map("first_name")
  middleName          String?  @map("middle_name")
  lastName            String   @map("last_name")
  photoUrl            String?  @map("photo_url")
  dateOfBirth         DateTime? @map("date_of_birth")
  gender              String?
  personalEmail       String?  @map("personal_email")
  phone               String?
  emergencyContact    String?  @map("emergency_contact")
  address             String?

  departmentId        String?  @map("department_id")
  teamId              String?  @map("team_id")
  designation         String
  reportingManagerId  String?  @map("reporting_manager_id")
  teamLeadId          String?  @map("team_lead_id")
  employmentType      String   @default("FULL_TIME") @map("employment_type") // FULL_TIME, PART_TIME, INTERN, CONTRACT, FREELANCER
  employmentStatus    String   @default("ACTIVE") @map("employment_status") // ACTIVE, ON_LEAVE, PROBATION, RESIGNED, TERMINATED
  workLocation        String   @default("Bengaluru HQ") @map("work_location")
  workMode            String   @default("OFFICE") @map("work_mode") // OFFICE, REMOTE, HYBRID
  joiningDate         DateTime @default(now()) @map("joining_date")

  // Sensitive Encrypted Fields (AES-256-GCM)
  bankAccountEncrypted String? @map("bank_account_encrypted")
  taxIdEncrypted       String? @map("tax_id_encrypted")
  salaryEncrypted      String? @map("salary_encrypted")

  createdAt           DateTime @default(now()) @map("created_at")
  updatedAt           DateTime @updatedAt @map("updated_at")

  organization        Organization       @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user                User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  department          Department?        @relation(fields: [departmentId], references: [id])
  team                Team?              @relation(fields: [teamId], references: [id])
  education           EmployeeEducation[]
  assignedTasks       TaskAssignee[]
  attendanceRecords   Attendance[]
  workSessions        WorkSession[]
  projectMemberships  ProjectMember[]

  @@unique([organizationId, employeeCode])
  @@index([organizationId, departmentId])
  @@map("employees")
}

model EmployeeEducation {
  id             String   @id @default(uuid())
  employeeId     String   @map("employee_id")
  level          String   // 10th, 12th/Diploma, Graduation, Post Graduation, Certifications, Training
  institute      String
  degree         String?
  specialization String?
  startDate      DateTime? @map("start_date")
  endDate        DateTime? @map("end_date")
  gradeScore     String?   @map("grade_score")
  certificateUrl String?   @map("certificate_url")
  createdAt      DateTime  @default(now()) @map("created_at")

  employee       Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  @@map("employee_educations")
}

model Project {
  id                String    @id @default(uuid())
  organizationId    String    @map("organization_id")
  code              String    // e.g. PRJ-ALPHA
  name              String
  description       String?
  clientId          String?   @map("client_id")
  projectManagerId  String?   @map("project_manager_id")
  startDate         DateTime  @map("start_date")
  expectedEndDate   DateTime  @map("expected_end_date")
  budget            Decimal?  @db.Decimal(12, 2)
  priority          String    @default("MEDIUM") // LOW, MEDIUM, HIGH, URGENT
  status            String    @default("ACTIVE") // PLANNED, ACTIVE, ON_HOLD, COMPLETED, CANCELLED
  techStack         String?   @map("tech_stack") // JSON or comma-separated
  createdAt         DateTime  @default(now()) @map("created_at")
  updatedAt         DateTime  @updatedAt @map("updated_at")

  organization      Organization      @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  tasks             Task[]
  members           ProjectMember[]
  milestones        ProjectMilestone[]

  @@unique([organizationId, code])
  @@map("projects")
}

model ProjectMember {
  id        String   @id @default(uuid())
  projectId String   @map("project_id")
  employeeId String  @map("employee_id")
  roleInProject String @default("CONTRIBUTOR") @map("role_in_project")
  allocatedPercentage Int @default(100) @map("allocated_percentage")
  createdAt DateTime @default(now()) @map("created_at")

  project   Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  employee  Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  @@unique([projectId, employeeId])
  @@map("project_members")
}

model ProjectMilestone {
  id          String   @id @default(uuid())
  projectId   String   @map("project_id")
  name        String
  description String?
  dueDate     DateTime @map("due_date")
  progress    Int      @default(0) // 0 - 100
  status      String   @default("PLANNED") // PLANNED, IN_PROGRESS, COMPLETED
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  project     Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@map("project_milestones")
}

model Task {
  id                 String    @id @default(uuid())
  organizationId     String    @map("organization_id")
  projectId          String    @map("project_id")
  taskNumber         String    @map("task_number") // e.g. TSK-101
  title              String
  description        String?
  moduleName         String?   @map("module_name")
  createdById        String?   @map("created_by_id")
  reviewerId         String?   @map("reviewer_id")
  priority           String    @default("MEDIUM") // LOW, MEDIUM, HIGH, URGENT
  status             String    @default("BACKLOG") // BACKLOG, ASSIGNED, IN_PROGRESS, BLOCKED, IN_REVIEW, CHANGES_REQUIRED, APPROVED, COMPLETED, CANCELLED
  startDate          DateTime? @map("start_date")
  dueDate            DateTime  @map("due_date")
  estimatedHours     Decimal   @default(1.0) @db.Decimal(6, 2) @map("estimated_hours")
  actualHours        Decimal   @default(0.0) @db.Decimal(6, 2) @map("actual_hours")
  acceptanceCriteria String?   @map("acceptance_criteria")
  createdAt          DateTime  @default(now()) @map("created_at")
  updatedAt          DateTime  @updatedAt @map("updated_at")

  organization       Organization     @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  project            Project          @relation(fields: [projectId], references: [id], onDelete: Cascade)
  assignees          TaskAssignee[]
  dependencies       TaskDependency[] @relation("TaskDependencies")
  dependedOnBy       TaskDependency[] @relation("DependedOnTasks")
  workSessions       WorkSession[]

  @@unique([organizationId, taskNumber])
  @@index([organizationId, projectId])
  @@map("tasks")
}

model TaskAssignee {
  id         String   @id @default(uuid())
  taskId     String   @map("task_id")
  employeeId String   @map("employee_id")
  assignedAt DateTime @default(now()) @map("assigned_at")
  acceptedAt DateTime? @map("accepted_at")

  task       Task     @relation(fields: [taskId], references: [id], onDelete: Cascade)
  employee   Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  @@unique([taskId, employeeId])
  @@map("task_assignees")
}

model TaskDependency {
  id                String   @id @default(uuid())
  taskId            String   @map("task_id")
  dependsOnTaskId   String   @map("depends_on_task_id")
  dependencyType    String   @default("BLOCKS") @map("dependency_type") // BLOCKS

  task              Task     @relation("TaskDependencies", fields: [taskId], references: [id], onDelete: Cascade)
  dependsOnTask     Task     @relation("DependedOnTasks", fields: [dependsOnTaskId], references: [id], onDelete: Cascade)

  @@unique([taskId, dependsOnTaskId])
  @@map("task_dependencies")
}

model Attendance {
  id             String    @id @default(uuid())
  organizationId String    @map("organization_id")
  employeeId     String    @map("employee_id")
  workDate       DateTime  @db.Date @map("work_date")
  clockIn        DateTime? @map("clock_in")
  clockOut       DateTime? @map("clock_out")
  totalHours     Decimal   @default(0.0) @db.Decimal(5, 2) @map("total_hours")
  status         String    @default("PRESENT") // PRESENT, ABSENT, LATE, HALF_DAY, ON_LEAVE
  notes          String?
  createdAt      DateTime  @default(now()) @map("created_at")
  updatedAt      DateTime  @updatedAt @map("updated_at")

  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  employee       Employee     @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  @@unique([organizationId, employeeId, workDate])
  @@map("attendance")
}

model WorkSession {
  id              String    @id @default(uuid())
  organizationId  String    @map("organization_id")
  employeeId      String    @map("employee_id")
  taskId          String?   @map("task_id")
  sessionType     String    @default("WORK") @map("session_type") // WORK, BREAK
  startedAt       DateTime  @default(now()) @map("started_at")
  stoppedAt       DateTime? @map("stopped_at")
  durationSeconds Int       @default(0) @map("duration_seconds")
  notes           String?
  createdAt       DateTime  @default(now()) @map("created_at")

  organization    Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  employee        Employee     @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  task            Task?        @relation(fields: [taskId], references: [id])

  @@index([organizationId, employeeId])
  @@map("work_sessions")
}

model AuditLog {
  id             String   @id @default(uuid())
  organizationId String   @map("organization_id")
  actorId        String?  @map("actor_id") // User ID
  action         String   // e.g. TASK_STATUS_CHANGE, USER_ROLE_MUTATE, PUNCH_IN
  entityName     String   @map("entity_name") // tasks, users, employees
  entityId       String?  @map("entity_id")
  beforeState    String?  @map("before_state") // JSON string
  afterState     String?  @map("after_state")  // JSON string
  ipAddress      String?  @map("ip_address")
  userAgent      String?  @map("user_agent")
  createdAt      DateTime @default(now()) @map("created_at")

  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId, entityName])
  @@index([organizationId, createdAt])
  @@map("audit_logs")
}
